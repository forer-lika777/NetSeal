<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
	<Fragment>
		<ComponentGroup Id="AppComponents">
			<Files Include="!(bindpath.NetSeal.Service)\**" Directory="SERVICEDIR">
				<Exclude Files="!(bindpath.NetSeal.Service)\NetSeal.Service.exe" />
				<Exclude Files="!(bindpath.NetSeal.Service)\*.pdb" />
			</Files>
			<Component Directory="SERVICEDIR" Guid="*">
				<File Id="ServiceExe" Source="!(bindpath.NetSeal.Service)\NetSeal.Service.exe" KeyPath="yes" />
				<ServiceInstall Id="InstallNetSealService" Name="NetSeal" DisplayName="NetSeal Service" Description="Auto dial service" Type="ownProcess" Start="auto" Account="LocalSystem" ErrorControl="normal">
					<util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart" RestartServiceDelayInSeconds="10" />
				</ServiceInstall>
				<ServiceControl Id="ControlNetSealService" Name="NetSeal" Stop="both" Remove="uninstall" Wait="yes" />
			</Component>

			<Files Include="!(bindpath.NetSeal.WinUI)\**" Directory="WINUIDIR">
				<Exclude Files="!(bindpath.NetSeal.WinUI)\*.pdb" />
				<Exclude Files="!(bindpath.NetSeal.WinUI)\NetSeal.WinUI.exe" />
			</Files>
			<Component Directory="WINUIDIR" Guid="*">
				<File Id="WinUIExe" Source="!(bindpath.NetSeal.WinUI)\NetSeal.WinUI.exe" KeyPath="yes" />
			</Component>
			<Component Directory="WINUIDIR" Guid="*">
				<Shortcut Id="WinUIShortcut" Directory="ProgramMenuFolder" Name="NetSeal" Target="[WINUIDIR]NetSeal.WinUI.exe" WorkingDirectory="WINUIDIR" />
				<RegistryValue Root="HKCU" Key="Software\NetSeal" Name="installed" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</ComponentGroup>
	</Fragment>
</Wix>