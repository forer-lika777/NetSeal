; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

; 相对 .iss 文件所在目录解析到仓库根，再指向 publish/
#define RepoRoot SourcePath + "..\..\"
#define PublishDir RepoRoot + "publish\"

#define MyAppName "Reimu's NetSeal"
#define MyAppVersion GetVersionNumbersString(PublishDir + "WinUI\NetSeal.WinUI.exe")
#define MyAppPublisher "forer4433"
#define MyAppExeName "NetSeal.WinUI.exe"

#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
AppId=B648C87A-053F-4855-B033-EF2F321394F8
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
LicenseFile={#RepoRoot}LICENSE
PrivilegesRequired=admin
OutputDir={#RepoRoot}dist
OutputBaseFilename=NetSeal_Setup
SolidCompression=yes
WizardStyle=modern windows11

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; WinUI 主 exe
Source: "{#PublishDir}WinUI\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
; WinUI 其余文件
Source: "{#PublishDir}WinUI\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.pdb,Microsoft.Windows.AI.*.dll,Microsoft.Web.WebView2.*.dll,Microsoft.Web.WebView2.*.xml,onnxruntime.dll,WebView2Loader.dll,Microsoft.ML.OnnxRuntime.dll,DirectML.dll"
; Service（AOT 产物）
Source: "{#PublishDir}Service\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs; Excludes: "*.pdb"

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; 注册并启动服务
Filename: "{sys}\sc.exe"; Parameters: "create NetSeal binPath= ""{app}\NetSeal.Service.exe"" start= auto DisplayName= ""NetSeal"""; Flags: runhidden
Filename: "{sys}\sc.exe"; Parameters: "start NetSeal"; Flags: runhidden
; 可选启动 UI
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{sys}\sc.exe"; Parameters: "stop NetSeal"; Flags: runhidden; RunOnceId: "StopNetSeal"
Filename: "{sys}\sc.exe"; Parameters: "delete NetSeal"; Flags: runhidden; RunOnceId: "DeleteNetSeal"