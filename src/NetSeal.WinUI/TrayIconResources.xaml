<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetSeal"
    xmlns:tb="using:H.NotifyIcon">
    <XamlUICommand x:Key="Command1" Label="Command1" Description="Command1"/>
    <XamlUICommand x:Key="ShowWindowCommand" Label="打开 NetSeal 应用界面" Description="打开 NetSeal 应用界面"/>
    <XamlUICommand x:Key="ExitApplicationCommand" Label="退出 NetSeal" Description="退出 NetSeal"/>
    <tb:TaskbarIcon x:Key="TrayIcon" Visibility="Visible" ToolTipText="ToolTip" 
                    ContextMenuMode="SecondWindow" LeftClickCommand="{StaticResource ShowWindowCommand}" 
                    NoLeftClickDelay="True" IconSource="\Assets\icon.ico">
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{StaticResource ShowWindowCommand}" HorizontalAlignment="Stretch" />
                <MenuFlyoutItem Command="{StaticResource ExitApplicationCommand}" HorizontalAlignment="Stretch"/>
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
