<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NetSeal.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetSeal.Pages"
    xmlns:models="using:NetSeal.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView>
        <Grid>
            <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
            <Grid Margin="60" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" >
                    <ListView ItemsSource="{x:Bind ViewModel.NetworkConnections, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedConnectionIndex, Mode=TwoWay}"
                              SelectionMode="Single" Height="700" VerticalAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkNameDisplayStatus">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"/>
                                    <TextBlock Grid.Column="1" Text="已选连接" Visibility="{x:Bind Selected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="未找到可用网络连接" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.HasAvailableConnections, Converter={StaticResource BoolToReversedVisibilityConverter}, Mode=OneWay}"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <InfoBar Margin="0, 20" Visibility="{x:Bind ViewModel.IsNotPppoeNetworkConnection, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsNotPppoeNetworkConnection, Mode=OneWay}" Severity="Informational"
                             Title="提示" Message="当前已接入互联网，无需进行 pppoe 网络拨号连接。" IsClosable="False">
                        <TextBlock Margin="40, 0, 0, 16" >
                            <Run Text="当前已连接到：" FontFamily="Microsoft YaHei UI"/>
                            <Run Text="{x:Bind ViewModel.ActiveNetworkName}" FontFamily="Microsoft YaHei UI"/>
                        </TextBlock>
                    </InfoBar>
                    <InfoBar Margin="0, 20" Visibility="{x:Bind ViewModel.IsOtherNetworkAdapterConnected, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsOtherNetworkAdapterConnected, Mode=OneWay}" Severity="Informational"
                             Title="提示" Message="您当前正在使用无线网络连接，请连接有线网络（以太网）来使用 pppoe 网络拨号连接。" IsClosable="False">
                        <TextBlock Margin="40, 0, 0, 16" >
                            <Run Text="当前的网络适配器：" FontFamily="Microsoft YaHei UI"/>
                            <Run Text="{x:Bind ViewModel.ActiveNetworkAdapterName}" FontFamily="Microsoft YaHei UI"/>
                        </TextBlock>
                    </InfoBar>
                    <InfoBar Margin="0, 20" Visibility="{x:Bind ViewModel.IsPppoeConnectionManagedByOutside, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                             IsOpen="{x:Bind ViewModel.IsPppoeConnectionManagedByOutside}" Severity="Informational"
                             Title="提示">
                        <TextBlock Margin="40, 0, 0, 16" Text="当前网络正在由外部 pppoe 网络拨号连接控制。网络名称："/>
                    </InfoBar>
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="网络"/>
                            <Grid>
                                <TextBlock Text="已连接" Visibility="{x:Bind ViewModel.IsInternetAccess, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                <TextBlock Text="未连接" Visibility="{x:Bind ViewModel.IsInternetAccess, Converter={StaticResource BoolToReversedVisibilityConverter}, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock>
                            <Run>已选网络：</Run>
                            <Run Text="{x:Bind ViewModel.SelectedConnectionName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBox x:Name="UsernameEnterBox" Text="{x:Bind ViewModel.AccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="UsernameEnterBox_KeyDown"/>
                        <PasswordBox x:Name="PasswordEnterBox" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" IsPasswordRevealButtonEnabled="True" 
                                     GotFocus="PasswordEnterBox_GotFocus" KeyDown="PasswordEnterBox_KeyDown"/>
                        <Button x:Name="ConnectButton" Content="连接" Command="{x:Bind ViewModel.ConnectCommand}"/>
                        <Button Content="终止连接" Command="{x:Bind ViewModel.DisConnectCommand}"/>
                        <TextBlock Text="{x:Bind ViewModel.DisplayMessage, Mode=OneWay}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

    </ScrollView>
</Page>
